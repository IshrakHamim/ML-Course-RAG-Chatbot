GEMINI_API_KEY=
GEMINI_USE_VERTEX=true                 # true for AQ.... keys, false for AIza... keys
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=50                    # set to 1 if check-gemini says batching is unsupported
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/ragbot
JWT_SECRET=                            # any long random string (at least 32 characters)
JWT_EXPIRE_MINUTES=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.6                      # tune with sample questions
CHUNK_SIZE=3000
CHUNK_OVERLAP=400
MEMORY_TURNS=6
MAX_MESSAGE_CHARS=2000
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Tests use a separate database (created automatically):
# TEST_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/ragbot_test
